# Local mock orchestrator + Vite / `pnpm tauri dev`.
# Copy to `.env` (gitignored). On this machine these are also set as
# Windows user environment variables so every new terminal inherits them.
#
# Use 127.0.0.1, not localhost: the mock binds IPv4 only.

# Dock (src-tauri/src/config.rs) — HTTP base the Rust client calls
LOOP_API_URL=http://127.0.0.1:8787
LOOP_AUTH_MODE=mock
LOOP_REDIRECT_URI=loop://auth/callback
# Comma-separated hosts `open_external` may open. Empty = any https URL.
# LOOP_EXTERNAL_HOSTS=example.service-now.com,example.fa.ocs.oraclecloud.com

# Entra (only if LOOP_AUTH_MODE=entra)
# LOOP_ENTRA_TENANT=
# LOOP_ENTRA_CLIENT_ID=
# LOOP_API_SCOPE=

# Browser harness (src/lib/env.ts). Ignored inside the Tauri webview.
VITE_MOCK_URL=http://127.0.0.1:8787

# Mock orchestrator (tools/mock-orchestrator)
MOCK_HOST=127.0.0.1
MOCK_PORT=8787
# MOCK_QUIET=1
